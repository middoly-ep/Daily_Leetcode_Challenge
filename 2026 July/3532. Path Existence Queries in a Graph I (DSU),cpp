#include <vector>

using namespace std;

class Solution {
public:
    vector<int> parent;
    int find(int x){
        return parent[x] == x ? x : parent[x] = find(parent[x]);
    }
    void unite(int a, int b){
        int rootA = find(a);
        int rootB = find(b);
        if (rootA == rootB) return;
        parent[rootB] = rootA;
    }
    vector<bool> pathExistenceQueries(int n, vector<int>& nums, int maxDiff, vector<vector<int>>& queries) {
        parent.resize(n);
        for (int i = 0; i < n; i++){
            parent[i] = i;
        }
        for (int i = 0; i < n - 1; i++){
            if (nums[i + 1] - nums[i] <= maxDiff) unite(i, i + 1);
        }

        vector<bool> res;
        for (auto v : queries){
            if (find(v[0]) == find(v[1])) res.push_back(true);
            else res.push_back(false);
        }
        return res;
    }
};
